# ─── Gamer Gear Discord Bot Configuration ──────────────────────
# Required: Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_bot_token_here

# Required: Target Discord Server (Guild) ID
DISCORD_GUILD_ID=your_guild_id_here

# Optional: Moderator role ID for alerts (if empty, alerts go to #ask-mods or server owner)
MOD_ROLE_ID=

# ─── Dedicated Hermes Autonomous Administrator Bot (Optional) ──
HERMES_DISCORD_TOKEN=your_hermes_bot_token_here
HERMES_ALLOWED_USERS=your_discord_user_id_here
HERMES_ALLOWED_ROLES=
HERMES_ADMIN_CHANNELS=

# ─── HTTP / Remote MCP Transport Configuration (Optional) ───────
PORT=3000
MCP_AUTH_TOKEN=your_strong_secret_bearer_token_here
