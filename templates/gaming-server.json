{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiscordServerTemplate",
  "description": "Configurable schema for defining full Discord server structures, roles, channels, and permissions.",
  "serverName": "Gaming Community",
  "roles": [
    {
      "name": "Owner",
      "color": "#E91E63",
      "hoist": true,
      "mentionable": true,
      "permissions": [
        "ManageGuild",
        "ManageRoles",
        "ManageChannels",
        "KickMembers",
        "BanMembers",
        "ManageMessages",
        "ViewChannel",
        "SendMessages",
        "Connect",
        "Speak"
      ]
    },
    {
      "name": "Admin",
      "color": "#9C27B0",
      "hoist": true,
      "mentionable": true,
      "permissions": [
        "ManageGuild",
        "ManageRoles",
        "ManageChannels",
        "KickMembers",
        "BanMembers",
        "ManageMessages",
        "ViewChannel",
        "SendMessages",
        "Connect",
        "Speak"
      ]
    },
    {
      "name": "Moderator",
      "color": "#2196F3",
      "hoist": true,
      "mentionable": true,
      "permissions": [
        "ManageMessages",
        "KickMembers",
        "MuteMembers",
        "DeafenMembers",
        "ViewChannel",
        "SendMessages",
        "Connect",
        "Speak"
      ]
    },
    {
      "name": "Member",
      "color": "#4CAF50",
      "hoist": false,
      "mentionable": false,
      "permissions": [
        "ViewChannel",
        "SendMessages",
        "EmbedLinks",
        "AttachFiles",
        "ReadMessageHistory",
        "AddReactions",
        "Connect",
        "Speak"
      ]
    },
    {
      "name": "New Member",
      "color": "#9E9E9E",
      "hoist": false,
      "mentionable": false,
      "permissions": [
        "ViewChannel",
        "ReadMessageHistory"
      ]
    }
  ],
  "categories": [
    {
      "name": "START HERE",
      "channels": [
        {
          "name": "welcome",
          "type": "text",
          "topic": "Welcome to the server! Read the rules and enjoy your stay.",
          "initialMessage": "Welcome to our Gaming Community! Check out #rules and introduce yourself in #introductions.",
          "permissionOverwrites": [
            {
              "role": "@everyone",
              "allow": ["ViewChannel", "ReadMessageHistory"],
              "deny": ["SendMessages", "AddReactions"]
            }
          ]
        },
        {
          "name": "rules",
          "type": "text",
          "topic": "Official community rules and guidelines.",
          "initialMessage": "📜 **Server Rules**\n1. Be respectful to all members.\n2. No spam or advertising.\n3. Keep topics in their designated channels.\n4. Follow Discord Community Guidelines.",
          "permissionOverwrites": [
            {
              "role": "@everyone",
              "allow": ["ViewChannel", "ReadMessageHistory"],
              "deny": ["SendMessages", "AddReactions"]
            }
          ]
        },
        {
          "name": "announcements",
          "type": "text",
          "topic": "Community updates and major news.",
          "permissionOverwrites": [
            {
              "role": "@everyone",
              "allow": ["ViewChannel", "ReadMessageHistory"],
              "deny": ["SendMessages"]
            },
            {
              "role": "Moderator",
              "allow": ["SendMessages"]
            },
            {
              "role": "Admin",
              "allow": ["SendMessages"]
            }
          ]
        }
      ]
    },
    {
      "name": "COMMUNITY",
      "channels": [
        {
          "name": "general-chat",
          "type": "text",
          "topic": "General chat for all community discussions."
        },
        {
          "name": "introductions",
          "type": "text",
          "topic": "Introduce yourself to fellow community members!"
        },
        {
          "name": "media",
          "type": "text",
          "topic": "Share screenshots, memes, and gaming clips."
        }
      ]
    },
    {
      "name": "GAMING",
      "channels": [
        {
          "name": "game-chat",
          "type": "text",
          "topic": "Discuss latest game updates, builds, and strategies."
        },
        {
          "name": "looking-for-group",
          "type": "text",
          "topic": "Find teammates and squad up for games."
        },
        {
          "name": "gaming-news",
          "type": "text",
          "topic": "Industry news and release dates."
        }
      ]
    },
    {
      "name": "VOICE",
      "channels": [
        {
          "name": "General Voice",
          "type": "voice"
        },
        {
          "name": "Gaming Room 1",
          "type": "voice",
          "userLimit": 5
        },
        {
          "name": "Gaming Room 2",
          "type": "voice",
          "userLimit": 5
        }
      ]
    },
    {
      "name": "STAFF",
      "permissionOverwrites": [
        {
          "role": "@everyone",
          "deny": ["ViewChannel"]
        },
        {
          "role": "Moderator",
          "allow": ["ViewChannel", "SendMessages", "ReadMessageHistory", "Connect", "Speak"]
        },
        {
          "role": "Admin",
          "allow": ["ViewChannel", "SendMessages", "ReadMessageHistory", "Connect", "Speak"]
        }
      ],
      "channels": [
        {
          "name": "staff-chat",
          "type": "text",
          "topic": "Private discussions for moderators and administrators."
        },
        {
          "name": "moderator-room",
          "type": "voice"
        }
      ]
    }
  ]
}

